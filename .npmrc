# 国内镜像。npm 官方 registry 在部分网络环境下不可达。
#
# 注意：`electron_mirror` / `electron_builder_binaries_mirror` 这两条以
# `_` 结尾的名字是 **electron 安装脚本** 读的，npm 11 会把它们当成未知配置
# 每次运行都打印 "Unknown project config" 警告 —— 已改为在
# scripts/build.mjs 与 package.json 的脚本里通过环境变量传入。
registry=https://registry.npmmirror.com
fund=false
audit=false
