{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/cli/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/test/**/*.ts"
  ]
}
